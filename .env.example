# Copy to .env on the VPS and set these to match your Traefik setup.
DOMAIN=cryptoguard.olamide.cloud
# HTTPS entrypoint name from Traefik's config (often websecure or https)
TRAEFIK_ENTRYPOINT=websecure
# ACME certificate resolver name from Traefik's config (often letsencrypt or le)
TRAEFIK_CERTRESOLVER=letsencrypt
